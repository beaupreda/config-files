[global]
    monitor = 0
    follow = none

    width = 300
    height = (0, 300)
    origin = top-right
    offset = (10, 50)

    scale = 0
    notification_limit = 20

    separator_height = 2
    padding = 8
    horizontal_padding = 8
    frame_width = 4

    frame_color = "#9e9b93"

    gap_size = 2

    font = JetBrainsMono Nerd Font 12

    sticky_history = yes
    history_length = 20

    corner_radius = 2
    corners = all

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all


[urgency_low]
    background = "#1d1c19"
    foreground = "#c8c093"
    timeout = 10

[urgency_normal]
    background = "#1d1c19"
    foreground = "#c8c093"
    timeout = 10

[urgency_critical]
    background = "#1d1c19"
    foreground = "#c8c093"
    frame_color = "#c4746e"
